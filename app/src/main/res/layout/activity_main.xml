<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sorelle_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SORELLE"
            android:textSize="28sp"
            android:letterSpacing="0.15"
            android:textColor="@color/sorelle_marrom" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESSENCE"
            android:textSize="11sp"
            android:letterSpacing="0.3"
            android:textColor="@color/sorelle_marrom"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card_verde">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COSMÉTICOS DA AMAZÔNIA"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textColor="@color/sorelle_dourado" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beleza que regenera a vida."
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alta performance em harmonia com a natureza. Plantamos árvores nativas por você."
                android:textSize="16sp"
                android:textColor="@color/sorelle_bege_card"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnProdutos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Conheça os Produtos"
                android:textColor="@color/sorelle_marrom"
                android:backgroundTint="@color/sorelle_fundo"
                app:cornerRadius="28dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnImpact"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Ver meu impacto"
            android:textColor="@color/sorelle_marrom"
            app:strokeColor="@color/sorelle_dourado"
            app:cornerRadius="28dp" />
        <TextView
            android:id="@+id/tvSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="Sair"
            android:textColor="@color/sorelle_marrom"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</ScrollView>